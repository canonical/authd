#!/bin/sh

set -eu

# In previous versions, the broker.conf was created with mode 0777 - umask.
# This is not secure, because the file can contain sensitive information
# (like the client_secret), so we ensure that the mode is 0600.
if [ -f "${SNAP_DATA}/broker.conf" ]; then
  chmod 0600 "${SNAP_DATA}/broker.conf"
fi

# Important: If you add new migrations, make sure to tag the commit which
# first introduces the change, so that pre-release versions which already
# contain the change (and which were automatically uploaded to the edge channel)
# will not be migrated.
INITIAL_WORLD_READABLE_BROKER_CONF_DIR="0.5.0-pre1"
# This migration is first shipped after broker-0.5.1. Tag its first commit as
# 0.5.2-pre1 so later edge refreshes do not re-enable legacy compatibility.
INITIAL_LEGACY_CONFIG_MIGRATION_VERSION="0.5.2-pre1"

# This filename references the validation rules shipped in 0.5.0; the
# migration boundary below is separate.
ALLOW_LEGACY_CONFIG_MARKER="${SNAP_DATA}/.allow-legacy-config-pre-0.5.0"

log() {
  logger -t "${SNAP_NAME}" "post-refresh: $*"
}

version_less_than() {
  # Broker snaps before 0.2.0 did not record their version in the pre-refresh hook,
  # so treat an empty version as lower than the current version.
  if [ -z "$1" ]; then
    return 0
  fi
  output=$(semver compare "$1" "$2") || exit 1
  [ "${output}" = "less" ]
}

valid_semver() {
  if ! output=$(semver check "$1") && [ "${output}" != "invalid" ]; then
    exit 1
  fi
  [ "${output}" = "valid" ]
}

should_transition_to_world_readable_broker_conf_dir() {
  version_less_than "${PREVIOUS_VERSION}" "${INITIAL_WORLD_READABLE_BROKER_CONF_DIR}"
}

should_enable_legacy_config_compatibility() {
  version_less_than "${PREVIOUS_VERSION}" "${INITIAL_LEGACY_CONFIG_MIGRATION_VERSION}"
}

transition_to_world_readable_broker_conf_dir() {
  log "Transitioning to world-readable broker.conf.d directory"
  dir="${SNAP_DATA}/broker.conf.d"

  # shellcheck disable=SC2174 # it's fine that --mode only applies to the deepest directory, because the SNAP_DATA
  # directory is created by snapd with the correct permissions.
  mkdir -p --mode=0755 "${dir}"

  # Ensure that the files in the broker config directory are *not* world-readable,
  # because they can contain sensitive information (like the client_secret).
  find "${dir}" -type f -exec chmod 0600 {} \;

  # Change the permissions of the broker config directory itself to be world-readable,
  # so that its files can be listed by non-root users, allowing tab-completion
  # to work correctly.
  chmod 0755 "${dir}"
}

enable_legacy_config_compatibility() {
  if [ -e "${ALLOW_LEGACY_CONFIG_MARKER}" ] || [ -L "${ALLOW_LEGACY_CONFIG_MARKER}" ]; then
    log "Legacy configuration marker already exists; leaving it unchanged"
    return
  fi

  log "Enabling legacy configuration compatibility for installs before the migration boundary"
  install -o root -g root -m 0600 /dev/null "${ALLOW_LEGACY_CONFIG_MARKER}"
}

if ! PREVIOUS_VERSION=$(snapctl get previous-version); then
  log "Could not read previous-version from snap configuration"
  exit 1
fi

if [ -z "${PREVIOUS_VERSION}" ]; then
  log "previous-version: <not set>; treating as older than migration boundaries"
elif ! valid_semver "${PREVIOUS_VERSION}"; then
  # A malformed value does not prove this is an old snap. Fail rather than
  # guessing which migrations are safe for an unknown version.
  log "previous-version: ${PREVIOUS_VERSION} (invalid semver); cannot determine required migrations"
  exit 1
else
  log "previous-version: $PREVIOUS_VERSION"
fi

if should_transition_to_world_readable_broker_conf_dir; then
  transition_to_world_readable_broker_conf_dir
fi
if should_enable_legacy_config_compatibility; then
  enable_legacy_config_compatibility
fi
