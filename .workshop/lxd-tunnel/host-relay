#!/bin/bash
set -euo pipefail

readonly UNIT="authd-workshop-lxd-relay.service"
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly RELAY_SOCKET="${RUNTIME_DIR}/authd-workshop-lxd.socket"

# Snap LXD first, then the deb/source-build path (mirrors host-console, which
# supports non-snap installs by falling back to the lxc on PATH).
lxd_socket() {
    if [ -S /var/snap/lxd/common/lxd/unix.socket ]; then
        echo /var/snap/lxd/common/lxd/unix.socket
    elif [ -S /var/lib/lxd/unix.socket ]; then
        echo /var/lib/lxd/unix.socket
    else
        return 1
    fi
}

usage() {
    cat >&2 <<EOF
Usage: .workshop/lxd-tunnel/host-relay <start|stop|status>

Manage the opt-in host-side relay used by the authd Workshop to reach LXD.

The relay grants the workshop host-root-equivalent LXD control. Stop it when
the companion VM is no longer needed (and disconnect the tunnel to drop the
workshop's handle on the relay socket):

  .workshop/lxd-tunnel/host-relay stop
  workshop disconnect authd-dev/lxd-tunnel:lxd

The relay is a systemd --user unit tied to your login session; it is not
removed automatically when the workshop stops or is removed.
EOF
}

die() {
    echo "host-lxd-relay: $*" >&2
    exit 1
}

start_relay() {
    command -v lxc >/dev/null 2>&1 ||
        die "lxc is not installed on the host"
    # Resolve the socat path once and pass it to systemd-run: the transient
    # unit does not share this shell's PATH.
    local socat_bin
    socat_bin="$(command -v socat)" ||
        die "socat is not installed; run 'sudo apt install socat'"
    local lxd_sock
    lxd_sock="$(lxd_socket)" ||
        die "no LXD daemon socket found (checked snap and deb locations)"
    lxc query local:/1.0 >/dev/null 2>&1 ||
        die "the current user cannot access LXD; add it to the lxd group and log in again"

    if systemctl --user is-active --quiet "${UNIT}"; then
        echo "Host LXD relay is already running at ${RELAY_SOCKET}."
        return
    fi

    rm -f -- "${RELAY_SOCKET}"
    systemd-run --user \
        --unit="${UNIT%.service}" \
        --collect \
        --service-type=exec \
        --property=Restart=on-failure \
        --property=RestartSec=2s \
        "${socat_bin}" \
        "UNIX-LISTEN:${RELAY_SOCKET},fork,mode=0600,unlink-close" \
        "UNIX-CONNECT:${lxd_sock}" >/dev/null

    for _ in $(seq 1 50); do
        if [ -S "${RELAY_SOCKET}" ]; then
            echo "Host LXD relay is running at ${RELAY_SOCKET}."
            return
        fi
        sleep 0.1
    done

    systemctl --user status --no-pager "${UNIT}" >&2 || true
    die "relay socket was not created"
}

stop_relay() {
    if systemctl --user is-active --quiet "${UNIT}"; then
        systemctl --user stop "${UNIT}"
    fi
    rm -f -- "${RELAY_SOCKET}"
    echo "Host LXD relay is stopped."
}

case "${1:-}" in
    start) start_relay ;;
    stop) stop_relay ;;
    status) systemctl --user status --no-pager "${UNIT}" ;;
    *)
        usage
        exit 2
        ;;
esac
