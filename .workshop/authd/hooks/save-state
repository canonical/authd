#!/bin/bash
# save-state — preserve authd and broker configuration across refresh.
#
# Workshop calls this hook as root before a refresh or restore rebuilds the VM.
# It saves configuration to $SDK_STATE_DIR for restore-state.
#
# $SDK_STATE_DIR carries this state across refresh and restore. Stop/start keeps
# the VM filesystem and does not run these hooks.
#
# Deliberately out of scope: /var/lib/authd, broker runtime data, and cloud
# homes. Back these up on the host after stopping services; copying live
# database files into SDK state storage is unsafe.
set -euo pipefail

# shellcheck disable=SC1091
source /project/.workshop/authd/lib/brokers.sh

if [ -f /etc/authd/authd.yaml ]; then
    install -m600 /etc/authd/authd.yaml "${SDK_STATE_DIR}/authd.yaml"
else
    rm -f "${SDK_STATE_DIR}/authd.yaml"
fi

state_dir="${SDK_STATE_DIR}/brokers"
rm -rf "$state_dir"
# This tree carries secrets: broker.conf holds client_secret.
# Keep it readable by root only.
mkdir -p "$state_dir"
chmod 700 "$state_dir"

saved=0
for variant in "${AUTHD_BROKER_VARIANTS[@]}"; do
    conf_dir="/etc/authd-${variant}"
    [ -f "${conf_dir}/broker.conf" ] || continue

    vdir="${state_dir}/${variant}"
    mkdir -p "$vdir"
    chmod 700 "$vdir"

    # Preserve the complete broker configuration tree, including generated and
    # manually maintained drop-ins such as owner registration.
    cp -a "${conf_dir}" "${vdir}/config"

    # authd broker registration (dbus_name, object path)
    [ -f "/etc/authd/brokers.d/${variant}.conf" ] \
        && cp "/etc/authd/brokers.d/${variant}.conf" "${vdir}/authd.conf"

    # D-Bus policy and name (allows the broker to own its bus name)
    if [ -f "${vdir}/authd.conf" ]; then
        dbus_name="$(sed -n 's/^dbus_name = //p' "${vdir}/authd.conf" 2>/dev/null || true)"
        if [ -n "$dbus_name" ]; then
            printf '%s\n' "$dbus_name" > "${vdir}/dbus_name"
            [ -f "/usr/share/dbus-1/system.d/${dbus_name}.conf" ] \
                && cp "/usr/share/dbus-1/system.d/${dbus_name}.conf" "${vdir}/dbus.conf"
        fi
    fi

    # systemd service unit
    [ -f "/etc/systemd/system/authd-${variant}.service" ] \
        && cp "/etc/systemd/system/authd-${variant}.service" "${vdir}/service"

    # Preserve enablement and current activity independently. A service may be
    # enabled but stopped for debugging, or running without being enabled.
    systemctl is-enabled --quiet "authd-${variant}.service" 2>/dev/null \
        && touch "${vdir}/was-enabled"
    systemctl is-active --quiet "authd-${variant}.service" 2>/dev/null \
        && touch "${vdir}/was-running"

    saved=$((saved + 1))
    printf 'Saved broker config: %s\n' "$variant"
done

printf 'Saved %d broker configuration(s).\n' "$saved"
