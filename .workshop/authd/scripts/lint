#!/bin/bash
set -euo pipefail

usage() {
    cat >&2 <<EOF
Usage: workshop run -- lint [-- LINT_ARGS...]
  Run the pinned golangci-lint wrapper. The first run compiles it (slow).
Examples:
  workshop run -- lint
  workshop run -- lint -- -C authd-oidc-brokers run
EOF
}

for _arg in "$@"; do
    case "$_arg" in
        -h|--help) usage; exit 0 ;;
    esac
done

AUTHD_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
if [ -r "${AUTHD_SCRIPT_DIR}/../lib/env.sh" ]; then
    source "${AUTHD_SCRIPT_DIR}/../lib/env.sh"
else
    source /project/.workshop/authd/lib/env.sh
fi
if [ -d /project ]; then
    cd /project
fi

args=()
for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
        --) ;;
        *) args+=("$arg") ;;
    esac
done

exec scripts/golangci-lint "${args[@]}"
