#!/bin/bash
set -euo pipefail

usage() {
    cat >&2 <<EOF
Usage: workshop run -- logs [TARGET] [-f|--follow] [-n|--lines N]
TARGET: all | brokers | authd | google | msentraid | oidc | <unit>
  no args: all, 200 lines, then exit
  -f: follow instead of exiting
  -n N: number of lines (default 200)
  <unit>: any systemd unit, e.g. gdm3, ssh
Examples:
  workshop run -- logs
  workshop run -- logs google
  workshop run -- logs -f all
  workshop run -- logs gdm3 -f -n 100
EOF
}

target="all"
follow=no
target_given=no
lines=200
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -f|--follow) follow=yes; shift ;;
        -n|--lines)
            [ $# -ge 2 ] || { echo "Missing value for $1" >&2; usage; exit 2; }
            lines="$2"
            [[ "$lines" =~ ^[0-9]+$ ]] || { echo "Invalid line count: $lines" >&2; exit 2; }
            shift 2
            ;;
        -*) echo "Unknown option: $1" >&2; usage; exit 2 ;;
        *)
            if [ "$target_given" = no ]; then
                target="$1"
                target_given=yes
            else
                echo "Too many targets: $target and $1" >&2
                usage
                exit 2
            fi
            shift
            ;;
    esac
done

journal_args=(--no-pager -n "$lines")
[ "$follow" = yes ] && journal_args+=(-f)

# shellcheck disable=SC1091
source "$(dirname -- "${BASH_SOURCE[0]}")/../lib/brokers.sh"

broker_args=()
for variant in "${AUTHD_BROKER_VARIANTS[@]}"; do
    broker_args+=(--unit="authd-${variant}.service")
done

case "$target" in
    all) journal_args+=(--unit=authd.service "${broker_args[@]}") ;;
    brokers) journal_args+=("${broker_args[@]}") ;;
    authd) journal_args+=(--unit=authd.service) ;;
    *)
        if authd_broker_build_tag "$target" >/dev/null; then
            journal_args+=(--unit="authd-${target}.service")
        else
            # Journal entries use the canonical name, not e.g. the gdm3 alias.
            # An expired transient unit can still have logs without a loaded unit.
            unit="$(systemctl show -p Id --value -- "$target" 2>/dev/null)" || unit=
            journal_args+=(--unit="${unit:-$target}")
        fi
        ;;
esac

exec sudo journalctl "${journal_args[@]}"
