#!/bin/bash
set -euo pipefail

usage() {
    cat >&2 <<EOF
Usage: workshop run -- gdm status | restart | logs [-f|--follow] [-n|--lines N]
  status: check gdm3 and the greeter PAM wiring
  restart: restart gdm3 (needed after a PAM rebuild)
  logs: show gdm3 journal (200 lines, exits unless -f)
Examples:
  workshop run -- gdm status
  workshop run -- gdm restart
  workshop run -- gdm logs -f
EOF
}

verb="${1:-}"
case "$verb" in
    -h|--help|"") usage; [ -n "$verb" ] && exit 0 || exit 2 ;;
esac
shift

AUTHD_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
if [ -r "${AUTHD_SCRIPT_DIR}/../lib/health-checks.sh" ]; then
    source "${AUTHD_SCRIPT_DIR}/../lib/health-checks.sh"
else
    source /project/.workshop/authd/lib/health-checks.sh
fi

case "$verb" in
    status)
        [ "$#" -eq 0 ] || { usage; exit 2; }
        rc=0
        authd_print_validate_line "gdm-authd PAM service" authd_check_gdm_pam || rc=1
        authd_print_validate_line "patched gnome-shell" authd_check_gdm_shell || rc=1
        authd_print_validate_line "gdm3 active" authd_check_gdm || rc=1
        exit "$rc"
        ;;
    restart)
        [ "$#" -eq 0 ] || { usage; exit 2; }
        sudo systemctl restart gdm3.service
        echo "gdm3 restarted."
        echo "Open the greeter with: workshop run -- console"
        ;;
    logs)
        exec "${AUTHD_SCRIPT_DIR}/logs" gdm3 "$@"
        ;;
    *) echo "Unknown verb: $verb" >&2; usage; exit 2 ;;
esac
