# Configuration and credentials for testing authd with the Microsoft Entra ID broker.
# Copy this file to e2e-tests-msentraid.env and fill in your values.
# That file is gitignored.
#
# run-tests.sh and yarf-console.sh load this file automatically when
# --broker authd-msentraid is specified.
# vm/provision-authd.sh also loads it when provisioning the VM for
# the Microsoft Entra ID broker.

BROKER=authd-msentraid

# Test user credentials (password + TOTP MFA).
E2E_USER=
E2E_PASSWORD=
TOTP_SECRET=

# Tenant-specific fixture data for entra_unix_uid_gid_provisioning.robot.
E2E_UNIX_IDS_UID_ATTRIBUTE=
E2E_UNIX_IDS_GID_ATTRIBUTE=
E2E_UNIX_IDS_EXPECTED_UID=
E2E_UNIX_IDS_EXPECTED_GID=
E2E_UNIX_IDS_EXPECTED_UGID=
E2E_UNIX_IDS_GROUP=
E2E_UNIX_IDS_GENERIC_GROUP=
E2E_UNIX_IDS_NO_GID_EXPECTED_UID=

# Dedicated account for the positive Unix ID tests. All three values must
# belong to the same user. These tests never fall back to E2E_USER.
E2E_UNIX_IDS_USER=
E2E_UNIX_IDS_PASSWORD=
E2E_UNIX_IDS_TOTP_SECRET=

# Optional account with a valid UID and at least one group without a GID.
E2E_UNIX_IDS_NO_GID_USER=
E2E_UNIX_IDS_NO_GID_PASSWORD=
E2E_UNIX_IDS_NO_GID_TOTP_SECRET=

# Dedicated account for login_entra_passwordless.robot. Its password is not
# needed: the test creates and consumes a TAP using the app credentials below.
E2E_PASSWORDLESS_USER=
# Optional account with a passwordless synced Entra passkey for the local-only
# fallback test. The test mints a TAP for this account and serializes concurrent
# release variants through the Graph TAP lifecycle.
E2E_PASSWORDLESS_PASSKEY_USER=
# Optional account with a password-enabled synced Entra passkey for the
# password fallback test.
E2E_PASSKEY_USER=

# Microsoft Entra ID app credentials
AUTHD_MSENTRAID_ISSUER_ID=
AUTHD_MSENTRAID_CLIENT_ID=
AUTHD_MSENTRAID_CLIENT_SECRET=
