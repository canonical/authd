# Configuration file for provisioning the e2e-tests VM.
# It only contains VM-level settings; broker credentials go in
# e2e-tests/e2e-tests-<broker>.env (see the .env.template files there).
# Copy this template to config.env and customize the values for your environment.

# Path to the SSH public key that will be injected into the VM for root access.
SSH_PUBLIC_KEY_FILE="${HOME}/.ssh/id_rsa.pub"

# Base name for the libvirt domain; the release codename is appended (e.g. e2e-runner-noble).
VM_NAME_BASE=e2e-runner

# Default Ubuntu release codename to provision (e.g. noble, resolute).
# Can be overridden per-invocation with --release.
RELEASE=resolute

# Optional comma-separated PPA and/or Ubuntu archive suites for all packages
# except authd (e.g. "resolute-proposed,authd-edge"). Can be overridden with
# repeated --apt-source options. If unset, the matching -proposed suite and
# authd-edge are added; if set, only the listed extra sources are added.
# APT_SOURCE=resolute-proposed,authd-edge

# Optional comma-separated PPA and/or Ubuntu archive suites for authd
# (e.g. "authd-dev,resolute-updates"). Can be overridden with repeated
# --authd-apt-source options. If unset, --authd-deb is used when supplied;
# otherwise APT selects authd from the enabled sources.
# AUTHD_APT_SOURCE=resolute-updates,authd-edge

# Optional Ubuntu archive suite from which to install the stable system package
# baseline for migration tests (e.g. resolute-updates). Can be overridden
# per-invocation with --apt-source-base.
# APT_SOURCE_BASE=resolute-updates

# Optional PPA or Ubuntu archive suite from which to install the stable authd
# baseline for migration tests (e.g. authd). Can be overridden per-invocation
# with --authd-apt-source-base. If unset, the stable authd PPA is used when it
# publishes the VM's Ubuntu suite; otherwise, the matching Ubuntu archive suite
# is used.
# AUTHD_APT_SOURCE_BASE=authd
