#!/usr/bin/dh-exec

# Install daemon
usr/bin/authd ${env:AUTHD_DAEMONS_PATH}

# Install CLI tool
usr/bin/authctl /usr/bin/

# Install the Entra Unix ID provisioning script
scripts/apply-entra-unix-ids /usr/bin/

# Install authd config file
debian/authd-config/authd.yaml /etc/authd/

# Restart running broker services after the system CA bundle changes
debian/update-ca-certificates-hook.sh => /etc/ca-certificates/update.d/authd

# Keep apport's native origins in sync with enabled authd PPAs.
debian/authd-native-origins /usr/lib/authd/
debian/authd-candidate-native-origins /usr/lib/authd/
debian/authd-edge-native-origins /usr/lib/authd/
debian/authd-dev-native-origins /usr/lib/authd/
debian/sync-authd-apport-native-origin.sh /usr/lib/authd/
debian/authd-apport-native-origin.apt-hook => /etc/apt/apt.conf.d/99authd-apport-native-origin

# Rename the authd PPA source after a release upgrade.
debian/rename-authd-ppa-source.sh /usr/lib/authd/

# Allow the release upgrader to retarget the stable authd PPA.
debian/authd-release-upgrades.cfg /etc/update-manager/release-upgrades.d/

# Install pam wrapper
usr/bin/pam => ${env:AUTHD_DAEMONS_PATH}/authd-pam

# pam-auth-update files
debian/pam-configs/authd /usr/share/pam-configs

# PAM libraries
${env:BUILT_PAM_LIBS_PATH}/pam_authd.so ${env:AUTHD_PAM_MODULES_PATH}
${env:BUILT_PAM_LIBS_PATH}/go-exec/pam_authd_exec.so ${env:AUTHD_PAM_MODULES_PATH}

# Install NSS library with right soname
target/${DEB_HOST_RUST_TYPE}/release/libnss_authd.so => /usr/lib/${DEB_TARGET_GNU_TYPE}/libnss_authd.so.2

# Shell completion scripts
shell-completion/bash/authctl /usr/share/bash-completion/completions/
shell-completion/zsh/_authctl /usr/share/zsh/vendor-completions/
shell-completion/fish/authctl.fish /usr/share/fish/vendor_completions.d/
